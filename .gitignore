# ==========================================

# OVIS Runtime .gitignore

# Python runtime + tooling hygiene

# ==========================================

# -------------------------------

# Python bytecode

# -------------------------------

**pycache**/
*.py[cod]
*$py.class

# -------------------------------

# Python build artifacts

# -------------------------------

build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# -------------------------------

# Virtual environments

# -------------------------------

.venv/
venv/
env/
ENV/

# -------------------------------

# Testing artifacts

# -------------------------------

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/
_pycache_/

# -------------------------------

# Type checkers / linters

# -------------------------------

.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# -------------------------------

# Local environment variables

# -------------------------------

.env
.env.*
!.env.example

# -------------------------------

# Logs

# -------------------------------

*.log
logs/

# -------------------------------

# Runtime temporary data

# -------------------------------

tmp/
temp/
*.tmp

# -------------------------------

# Generated schemas

# (generated by export tools)

# -------------------------------

schemas/generated/

# -------------------------------

# Jupyter / notebooks

# -------------------------------

.ipynb_checkpoints/

# -------------------------------

# OS files

# -------------------------------

.DS_Store
Thumbs.db

# -------------------------------

# IDE / Editor settings

# -------------------------------

.vscode/
.idea/

# -------------------------------

# Coverage / profiling

# -------------------------------

coverage.xml
.prof

# -------------------------------

# Python packaging lock files

# (optional depending on workflow)

# -------------------------------

poetry.lock
Pipfile.lock
